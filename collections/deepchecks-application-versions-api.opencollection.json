{
  "opencollection": "1.0.0",
  "info": {
    "name": "Deepchecks LLM Evaluation Application Versions API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Application Versions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List application versions.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.llm.deepchecks.com/api/v1/application-versions",
            "params": [
              {
                "name": "app_name",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List application versions."
        },
        {
          "info": {
            "name": "Create an application version.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.llm.deepchecks.com/api/v1/application-versions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an application version."
        }
      ]
    }
  ],
  "bundled": true
}