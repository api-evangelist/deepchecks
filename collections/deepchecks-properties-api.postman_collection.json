          "name": "Update LLM property display names.",
          "request": {
            "name": "Update LLM property display names.",
            "description": {
              "content": "Updates the display names and definitions for LLM properties on an application.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "applications",
                ":app_id",
                "llm-prop-definitions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "app_id",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"definitions\": {\n    \"type\": \"array\",\n    \"maxItems\": 2,\n    \"items\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"name\": {\n          \"type\": \"string\",\n          \"default\": \"<string>\"\n        },\n        \"display_name\": {\n          \"type\": \"string\",\n          \"default\": \"<string>\"\n        }\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
